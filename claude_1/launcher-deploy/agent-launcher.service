[Unit]
Description=Troll Farm agent launcher (wake-on-work doorbell, no-LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tarstars
Group=tarstars
WorkingDirectory=/home/tarstars/launcher-clone
Environment=HOME=/home/tarstars
Environment=PATH=/home/tarstars/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/tarstars/launcher-clone/scripts/agent_launcher.py --config /home/tarstars/launcher-config.json
Restart=on-abnormal
RestartSec=30

[Install]
WantedBy=multi-user.target
