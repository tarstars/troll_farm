+                            && (unit.stats.harvest_power > 0 || unit.stats.chop_power > 0)
+                    })
+                    .count()
+                    .clamp(1, 2) as i32;
+                Self::ceil_positive(sum, funders)
+            }
+
+            fn update_mode(&mut self, view: &GameState, train_now: bool) {
+                if self.mode == EconomyMode::Deforest {
+                    return;
+                }
+                let roster = Self::roster(view);
+                let floor_unaffordable = !Self::floor_affordable(view);
+                let hard_switch = Self::switch_deadline(roster)
+                    .is_some_and(|deadline| view.turn >= deadline);
+                if roster >= 5
+                    || view.turn > Self::LAST_TRAIN_TURN
+                    || (!train_now
+                        && floor_unaffordable
+                        && (hard_switch
+                            || view.turn.saturating_add(Self::projected_floor_eta(view))
+                                > Self::LAST_TRAIN_TURN))
+                {
+                    self.mode = EconomyMode::Deforest;
+                    if self
+                        .plant_job
+                        .is_some_and(|job| job.purpose == PlantPurpose::Orchard)
+                    {
+                        self.plant_job = None;
+                    }
+                }
+            }
+
+            fn reconcile_port_state(&mut self, view: &GameState) {
+                self.owned_plants.retain(|cell, kind| {
+                    view.plant_at(*cell)
+                        .map(|index| {
+                            view.plants[index].kind == *kind && view.plants[index].health > 0
+                        })
+                        .unwrap_or(false)
+                });
+                let Some(mut job) = self.plant_job else {
+                    return;
+                };
+                let Some(unit) = view
+                    .units
+                    .iter()
+                    .find(|unit| unit.player == 0 && unit.id == job.unit_id)
+                else {
+                    self.plant_job = None;
+                    return;
+                };
+                if (self.mode == EconomyMode::Deforest
+                    && job.purpose == PlantPurpose::Orchard)
+                    || (self.mode == EconomyMode::Produce
+                        && job.purpose == PlantPurpose::Conversion)
+                {
+                    self.plant_job = None;
+                    return;
+                }
+                match job.stage {
+                    PlantStage::Acquire => {
+                        if view.inventories[0][job.kind.item_index()] <= 0
+                            || view.plant_at(job.cell).is_some()
+                        {
+                            self.plant_job = None;
+                        }
+                    }
+                    PlantStage::Carry => {
+                        if unit.carry[job.kind.item_index()] <= 0 {
+                            self.plant_job = None;
+                        } else if view.plant_at(job.cell).is_some() {
+                            self.plant_job = None;
+                        }
+                    }
+                    PlantStage::AwaitPlant => {
+                        let planted = view
+                            .plant_at(job.cell)
+                            .map(|index| {
+                                view.plants[index].kind == job.kind
+                                    && view.plants[index].health > 0
+                            })
+                            .unwrap_or(false);
+                        if planted {
+                            self.owned_plants.insert(job.cell, job.kind);
+                            if job.purpose == PlantPurpose::Conversion {
+                                job.stage = PlantStage::Cut;
+                                self.plant_job = Some(job);
+                            } else {
+                                self.plant_job = None;
+                            }
+                        } else {
+                            self.plant_job = None;
+                        }
+                    }
+                    PlantStage::Cut => {
+                        let alive = view
+                            .plant_at(job.cell)
+                            .map(|index| {
+                                view.plants[index].kind == job.kind
+                                    && view.plants[index].health > 0
+                            })
+                            .unwrap_or(false);
+                        if !alive {
+                            self.owned_plants.remove(&job.cell);
+                            self.plant_job = None;
+                        }
+                    }
+                }
+            }
+
+            fn orchard_target(kind: PlantKind) -> i32 {
+                match kind {
+                    PlantKind::Lemon | PlantKind::Plum => 3,
+                    PlantKind::Apple => 1,
+                    PlantKind::Banana => 0,
+                }
+            }
+
+            fn owned_count(&self, kind: PlantKind) -> i32 {
+                self.owned_plants
+                    .values()
+                    .filter(|owned| **owned == kind)
+                    .count() as i32
+            }
+
+            fn resource_deficit(view: &GameState, kind: PlantKind) -> bool {
+                let Some(cost) = Self::floor_cost(view) else {
+                    return false;
+                };
+                let item = kind.item_index();
+                view.inventories[0][item] < cost[item]
+            }
+
+            fn orchard_kind_for_pick(&self, view: &GameState) -> Option<PlantKind> {
+                let cost = Self::floor_cost(view)?;
+                [PlantKind::Lemon, PlantKind::Plum, PlantKind::Apple]
+                    .into_iter()
+                    .enumerate()
+                    .filter_map(|(priority, kind)| {
+                        let shortfall = Self::orchard_target(kind) - self.owned_count(kind);
+                        let item = kind.item_index();
+                        (shortfall > 0 && view.inventories[0][item] > cost[item])
+                            .then_some((shortfall, -(priority as i32), kind))
+                    })
+                    .max()
+                    .map(|(_, _, kind)| kind)
+            }
+
+            fn conversion_kind(view: &GameState) -> Option<PlantKind> {
+                [
+                    PlantKind::Banana,
+                    PlantKind::Plum,
+                    PlantKind::Lemon,
+                    PlantKind::Apple,
+                ]
+                .into_iter()
+                .enumerate()
+                .filter(|(_, kind)| view.inventories[0][kind.item_index()] > 0)
+                .min_by_key(|(priority, kind)| (tree_health(*kind, 1), *priority))
+                .map(|(_, kind)| kind)
+            }
+
+            fn plant_cell(view: &GameState, unit: &Unit) -> Option<Cell> {
+                let from_ours = bfs_distances(&view.walkable, &[view.shacks[0]]);
+                let from_theirs = bfs_distances(&view.walkable, &[view.shacks[1]]);
+                let from_unit = bfs_distances(&view.walkable, &[unit.cell]);
+                view.walkable
+                    .iter()
+                    .filter(|cell| view.plant_at(**cell).is_none())
+                    .filter(|cell| {
+                        !view
+                            .units
+                            .iter()
+                            .any(|other| other.id != unit.id && other.cell == **cell)
+                    })
+                    .filter(|cell| {
+                        from_ours.get(*cell).copied().unwrap_or(10_000) <= 4
+                            && from_ours.get(*cell).copied().unwrap_or(10_000)
+                                <= from_theirs.get(*cell).copied().unwrap_or(10_000)
+                            && from_unit.contains_key(*cell)
+                    })
+                    .min_by_key(|cell| {
+                        (
+                            from_ours[*cell] + from_unit[*cell],
+                            from_ours[*cell],
+                            **cell,
+                        )
+                    })
+                    .copied()
+            }
+
+            fn prepare_plant_job(&mut self, view: &GameState, train_now: bool) {
+                if self.plant_job.is_some() || train_now {
+                    return;
+                }
+                let mut units: Vec<&Unit> = view
+                    .units
+                    .iter()
+                    .filter(|unit| unit.player == 0)
+                    .collect();
+                units.sort_by_key(|unit| unit.id);
+                if self.mode == EconomyMode::Produce {
+                    for unit in &units {
+                        for kind in [PlantKind::Lemon, PlantKind::Plum, PlantKind::Apple] {
+                            if unit.carry[kind.item_index()] > 0
+                                && !Self::resource_deficit(view, kind)
+                                && self.owned_count(kind) < Self::orchard_target(kind)
+                            {
+                                if let Some(cell) = Self::plant_cell(view, unit) {
+                                    self.plant_job = Some(PlantJob {
+                                        unit_id: unit.id,
+                                        kind,
+                                        cell,
+                                        purpose: PlantPurpose::Orchard,
+                                        stage: PlantStage::Carry,
+                                    });
+                                    return;
+                                }
+                            }
+                        }
+                    }
+                    let Some(kind) = self.orchard_kind_for_pick(view) else {
+                        return;
+                    };
+                    if let Some((unit, cell)) = units
+                        .iter()
+                        .filter(|unit| unit.total_carried() == 0)
+                        .filter_map(|unit| Self::plant_cell(view, unit).map(|cell| (*unit, cell)))
+                        .min_by_key(|(unit, cell)| {
+                            (manhattan(unit.cell, view.shacks[0]), unit.id, *cell)
+                        })
+                    {
+                        self.plant_job = Some(PlantJob {
+                            unit_id: unit.id,
+                            kind,
+                            cell,
+                            purpose: PlantPurpose::Orchard,
+                            stage: PlantStage::Acquire,
+                        });
+                    }
+                } else if Self::roster(view) >= 2 {
+                    let Some(kind) = Self::conversion_kind(view) else {
+                        return;
+                    };
+                    let choice = units
+                        .iter()
+                        .filter(|unit| {
+                            unit.total_carried() == 0 && unit.stats.chop_power > 0
+                        })
+                        .filter_map(|unit| {
+                            let cell = Self::plant_cell(view, unit)?;
+                            let travel = bfs_distances(&view.walkable, &[unit.cell])
+                                .get(&cell)
+                                .copied()
+                                .unwrap_or(10_000);
+                            let turns = travel
+                                + Self::conversion_chop_turns(
+                                    view,
+                                    cell,
+                                    kind,
+                                    unit.stats.chop_power,
+                                )
+                                + 3;
+                            (turns <= TOTAL_TURNS - view.turn + 1).then_some((
+                                -unit.stats.chop_power,
+                                travel,
+                                unit.id,
+                                *unit,
+                                cell,
+                            ))
+                        })
+                        .min_by_key(|choice| (choice.0, choice.1, choice.2));
+                    if let Some((_, _, _, unit, cell)) = choice {
+                        self.plant_job = Some(PlantJob {
+                            unit_id: unit.id,
+                            kind,
+                            cell,
+                            purpose: PlantPurpose::Conversion,
+                            stage: PlantStage::Acquire,
+                        });
+                    }
+                }
+            }
+
+            fn job_candidates(view: &GameState, unit: &Unit, job: PlantJob) -> Vec<Candidate> {
+                let mut out = vec![MoisanBot::wait()];
+                match job.stage {
+                    PlantStage::Acquire => {
+                        if is_adjacent(unit.cell, view.shacks[0]) {
+                            out.push(Candidate {
+                                command: format!("PICK {} {}", unit.id, job.kind.as_str()),
+                                score: 20_000.0,
+                                target: Target::Cell(job.cell),
+                            });
+                        } else {
+                            out.extend(
+                                Self::bank_candidates(view, unit)
+                                    .into_iter()
+                                    .filter(|candidate| candidate.command.starts_with("MOVE "))
+                                    .map(|mut candidate| {
+                                        candidate.target = Target::Cell(job.cell);
+                                        candidate
+                                    }),
+                            );
+                        }
+                    }
+                    PlantStage::Carry => {
+                        out.push(Candidate {
+                            command: if unit.cell == job.cell {
+                                format!("PLANT {} {}", unit.id, job.kind.as_str())
+                            } else {
+                                format!("MOVE {} {} {}", unit.id, job.cell.0, job.cell.1)
+                            },
+                            score: 20_000.0,
+                            target: Target::Cell(job.cell),
+                        });
+                    }
+                    PlantStage::Cut => {
+                        out.push(Candidate {
+                            command: if unit.cell == job.cell {
+                                format!("CHOP {}", unit.id)
+                            } else {
+                                format!("MOVE {} {} {}", unit.id, job.cell.0, job.cell.1)
+                            },
+                            score: 20_000.0,
+                            target: Target::Tree(job.cell),
+                        });
+                    }
+                    PlantStage::AwaitPlant => {}
+                }
+                out
+            }
+
+            fn selected_miner(view: &GameState) -> Option<i32> {
+                let cost = Self::floor_cost(view)?;
+                if view.iron.is_empty() || view.inventories[0][IRON] >= cost[IRON] {
+                    return None;
+                }
+                view.units
+                    .iter()
+                    .filter(|unit| unit.player == 0 && unit.stats.chop_power > 0)
+                    .filter(|unit| {
+                        unit.total_carried() == 0 || unit.total_carried() == unit.carry[IRON]
+                    })
+                    .min_by_key(|unit| {
+                        let distance = view
+                            .iron
+                            .iter()
+                            .flat_map(|iron| ortho_neighbors(*iron))
+                            .filter_map(|cell| {
+                                bfs_distances(&view.walkable, &[unit.cell])
+                                    .get(&cell)
+                                    .copied()
+                            })
+                            .min()
+                            .unwrap_or(10_000);
+                        (unit.carry[IRON] == 0, distance, unit.id)
+                    })
+                    .map(|unit| unit.id)
+            }
+
+            fn produce_candidates(
+                &self,
+                view: &GameState,
+                unit: &Unit,
+                miner: Option<i32>,
+            ) -> Vec<Candidate> {
+                if let Some(job) = self.plant_job.filter(|job| job.unit_id == unit.id) {
+                    return Self::job_candidates(view, unit, job);
+                }
+                if unit.free_capacity() <= 0 {
+                    return Self::bank_candidates(view, unit);
+                }
+                let mut out = vec![MoisanBot::wait()];
+                let mut productive = false;
+                for kind in [PlantKind::Plum, PlantKind::Lemon, PlantKind::Apple] {
+                    if unit.stats.harvest_power > 0
+                        && (unit.total_carried() == 0 || unit.carry[kind.item_index()] > 0)
+                    {
+                        let candidates = MoisanBot::fruit_candidates(
+                            view,
+                            unit,
+                            kind,
+                            if Self::resource_deficit(view, kind) {
+                                6_000.0
+                            } else {
+                                1_000.0
+                            },
+                        );
+                        productive |= !candidates.is_empty();
+                        out.extend(candidates);
+                    }
+                }
+                if miner == Some(unit.id)
+                    && (unit.total_carried() == 0 || unit.carry[IRON] > 0)
+                {
+                    let candidates = MoisanBot::iron_candidates(view, unit, 6_100.0);
+                    productive |= !candidates.is_empty();
+                    out.extend(candidates);
+                }
+                if unit.total_carried() == 0 && !productive {
+                    let candidates = Self::yamo_chop_candidates(
+                        view,
+                        unit,
+                        self.type_to_cut,
+                        self.opponent_eta_penalty,
+                    );
+                    productive |= !candidates.is_empty();
+                    out.extend(candidates);
+                }
+                if unit.total_carried() > 0
+                    && (is_adjacent(unit.cell, view.shacks[0]) || !productive)
+                {
+                    out.extend(Self::bank_candidates(view, unit));
+                }
+                out
+            }
+
+            fn deforest_candidates(&self, view: &GameState, unit: &Unit) -> Vec<Candidate> {
+                if let Some(job) = self.plant_job.filter(|job| job.unit_id == unit.id) {
+                    return Self::job_candidates(view, unit, job);
+                }
+                if unit.free_capacity() <= 0 {
+                    return Self::bank_candidates(view, unit);
+                }
+                if unit.carry[PLUM] + unit.carry[LEMON] + unit.carry[APPLE]
+                    + unit.carry[BANANA] + unit.carry[IRON]
+                    > 0
+                {
+                    return Self::bank_candidates(view, unit);
+                }
+                let mut out = vec![MoisanBot::wait()];
+                let chops = Self::yamo_chop_candidates(
+                    view,
+                    unit,
+                    self.type_to_cut,
+                    self.opponent_eta_penalty,
+                );
+                if chops.is_empty() && unit.total_carried() > 0 {
+                    out.extend(Self::bank_candidates(view, unit));
+                } else {
+                    out.extend(chops);
+                    if unit.total_carried() > 0 && is_adjacent(unit.cell, view.shacks[0]) {
+                        out.extend(Self::bank_candidates(view, unit));
+                    }
+                }
+                out
+            }
+
+            fn remember_port_job(&mut self, commands: &[String]) {
+                let Some(mut job) = self.plant_job else {
+                    return;
+                };
+                if let Some(command) = MoisanBot::command_for_unit(commands, job.unit_id) {
+                    if command.starts_with("PICK ") {
+                        job.stage = PlantStage::Carry;
+                    } else if command.starts_with("PLANT ") {
+                        job.stage = PlantStage::AwaitPlant;
+                    }
+                    self.plant_job = Some(job);
+                }
+            }
+
+            // ---- the v6 wire -----------------------------------------------------------------
+            // Reads only. Nothing here decides anything. v6 is v5's payload with `m=` deleted --
+            // there is no margin constant to disambiguate a wire with, which is itself the
+            // version's signature -- plus the three-valued `k=` and the keep census.
+            fn narrate_target(target: Target) -> String {
+                match target {
+                    Target::None => "NONE".to_string(),
+                    Target::Shack => "SHACK".to_string(),
+                    Target::Bank(cell) => format!("BANK({},{})", cell.0, cell.1),
+                    Target::Cell(cell) => format!("CELL({},{})", cell.0, cell.1),
+                    Target::Tree(cell) => format!("TREE({},{})", cell.0, cell.1),
+                }
+            }
+            // `k=2` restricted AND the emitted command carried the kept goal; `k=1` the unit holds
+            // a valid kept goal whose emitted command does not carry it -- the not-live case, and
+            // (F6) the case where `resolve_move_conflicts` rewrote a restricted command into
+            // something no candidate proposed; `k=0` no valid kept goal, including a goal released
+            // as contested this turn, which is why `xc` and `k` are read together and never apart.
+            fn keep_code(
+                &self,
+                id: i32,
+                goal_lists: &BTreeMap<i32, Vec<Candidate>>,
+                restricted: &BTreeSet<i32>,
+                commands: &[String],
+            ) -> char {
+                let Some(goal) = self.kept_goals.get(&id) else {
+                    return '0';
+                };
+                if restricted.contains(&id) {
+                    if let Some(command) = MoisanBot::command_for_unit(commands, id) {
+                        let carried = goal_lists
+                            .get(&id)
+                            .map_or(false, |list| {
+                                list.iter().any(|candidate| {
+                                    candidate.command == command && candidate.target == *goal
+                                })
+                            });
+                        if carried {
+                            return '2';
+                        }
+                    }
+                }
+                '1'
+            }
+            fn narrate_message(
+                &self,
+                view: &GameState,
+                by_id: &BTreeMap<i32, Vec<Candidate>>,
+                restricted: &BTreeSet<i32>,
+                commands: &[String],
+                branch: &BTreeMap<i32, char>,
+                meta: &KeepMeta,
+                w_collisions: u32,
+                banner: Option<&str>,
+            ) -> String {
+                // Every live own unit exactly once, ids ascending, roster taken from the VIEW.
+                let mut ids: Vec<i32> = view
+                    .units
+                    .iter()
+                    .filter(|unit| unit.player == 0)
+                    .map(|unit| unit.id)
+                    .collect();
+                ids.sort();
+                let mut tokens: Vec<String> = vec![format!("NARRATE v6 t={}", view.turn)];
+                for id in ids {
+                    let chosen = MoisanBot::command_for_unit(commands, id)
+                        .and_then(|command| {
+                            by_id
+                                .get(&id)
+                                .and_then(|list| MoisanBot::matched_target(list, &command))
+                        })
+                        .unwrap_or(Target::None);
+                    let want = match by_id.get(&id) {
+                        Some(list) => match list
+                            .iter()
+                            .max_by(|a, b| a.score.total_cmp(&b.score))
+                        {
+                            Some(candidate) => Self::narrate_target(candidate.target),
+                            None => "ABSENT".to_string(),
+                        },
+                        None => "ABSENT".to_string(),
+                    };
+                    let code = branch.get(&id).copied().unwrap_or('N');
+                    // `b=` is v4's `blocked_turns`, kept in the shape for the decoder's benefit
+                    // and identically 0: Candidate 1's hold was its only writer and it is retired.
+                    tokens.push(format!(
+                        "u{}={}/{}/r={}/b=0/k={}",
+                        id,
+                        Self::narrate_target(chosen),
+                        want,
+                        code,
+                        self.keep_code(id, by_id, restricted, commands)
+                    ));
+                }
+                // `pz=1`, `sp=0` and the four exchange counters have no writer in a Candidate 3
+                // arm: R5 adds no holder and there is no exchange rule here. They are carried with
+                // v5's meanings unchanged (r6 C4) and a violation is a defect in R5.
+                tokens.push("pz=1".to_string());
+                tokens.push("sp=0".to_string());
+                tokens.push(format!("wc={}", w_collisions));
+                tokens.push("sw=0".to_string());
+                tokens.push("so=0".to_string());
+                tokens.push("sn=0".to_string());
+                tokens.push("sf=0".to_string());
+                tokens.push(format!("kp={}", meta.kp));
+                tokens.push(format!("kq={}", meta.kq));
+                tokens.push(format!("kl={}", meta.kl));
+                tokens.push(format!("kr={}", meta.kr));
+                tokens.push(format!("rd={}", meta.rd));
+                tokens.push(format!("rg={}", meta.rg));
+                tokens.push(format!("ri={}", meta.ri));
+                tokens.push(format!("rx={}", meta.rx));
+                tokens.push(format!("rf={}", meta.rf));
+                tokens.push(format!("rt={}", meta.rt));
+                tokens.push(format!("ro={}", meta.ro));
+                tokens.push(format!("nl={}", meta.nl));
+                tokens.push(format!("nl_producer={}", meta.nl_producer));
+                tokens.push(format!("nl_door={}", meta.nl_door));
+                tokens.push(format!("nl_admissibility={}", meta.nl_admissibility));
+                tokens.push(format!("nl_other={}", meta.nl_other));
+                tokens.push(format!("ka={}", meta.ka));
+                tokens.push(format!("kc={}", meta.kc));
+                tokens.push(format!("xc={}", meta.xc));
+                tokens.push(format!("xw={}", meta.xw));
+                tokens.push(format!("xn={}", meta.xn));
+                tokens.push(format!("xp={}", meta.xp));
+                tokens.push(format!("xg={}", meta.xg));
+                tokens.push(format!("xd={}", meta.xd));
+                tokens.push(format!("xj={}", meta.xj));
+                let body = tokens.join(" ");
+                match banner {
+                    Some(text) => format!("MSG {} {}", text, body),
+                    None => format!("MSG {}", body),
+                }
+            }
+        }
+        impl Bot for YamoBot {
+            fn commands(&mut self, view: &GameState) -> Vec<String> {
+                self.reconcile_port_state(view);
+                if self.type_to_cut.is_none() {
+                    self.type_to_cut = Some(MoisanBot::focus_type(view));
+                }
