+        #[cfg(test)]
+        mod port_tests {
+            use super::*;
+            use crate::game::types::ITEM_COUNT;
+
+            fn worker(id: i32, cell: Cell) -> Unit {
+                Unit {
+                    id,
+                    player: 0,
+                    cell,
+                    stats: Stats {
+                        movement_speed: 2,
+                        carry_capacity: 3,
+                        harvest_power: 1,
+                        chop_power: 2,
+                    },
+                    carry: [0; ITEM_COUNT],
+                }
+            }
+
+            fn test_view(roster: usize, turn: i32, with_iron: bool) -> GameState {
+                let mut walkable = BTreeSet::new();
+                for x in 1..=9 {
+                    for y in 1..=5 {
+                        walkable.insert((x, y));
+                    }
+                }
+                if with_iron {
+                    walkable.remove(&(5, 3));
+                }
+                let cells = [(1, 3), (1, 2), (1, 4), (2, 3), (2, 2)];
+                let units = cells
+                    .iter()
+                    .take(roster)
+                    .enumerate()
+                    .map(|(id, cell)| worker(id as i32, *cell))
+                    .collect();
+                let plants = [
+                    (PlantKind::Plum, (4, 3)),
+                    (PlantKind::Lemon, (3, 2)),
+                    (PlantKind::Apple, (3, 4)),
+                ]
+                .into_iter()
+                .map(|(kind, cell)| Plant {
+                    kind,
+                    cell,
+                    size: 3,
+                    health: 10,
+                    fruits: 20,
+                    cooldown: 0,
+                })
+                .collect();
+                GameState {
+                    width: 11,
+                    height: 7,
+                    walkable,
+                    shacks: [(0, 3), (10, 3)],
+                    inventories: [[0; ITEM_COUNT]; 2],
+                    units,
+                    plants,
+                    scores: [0, 0],
+                    turn,
+                    next_id: roster as i32,
+                    iron: if with_iron {
+                        [(5, 3)].into_iter().collect()
+                    } else {
+                        BTreeSet::new()
+                    },
+                    water: BTreeSet::new(),
+                }
+            }
+
+            fn bot() -> YamoBot {
+                YamoBot::tuned_carry_regeneration_transit_idle_harvest()
+            }
+
+            #[test]
+            fn roster_three_turn_106_stays_produce() {
+                let view = test_view(3, 106, true);
+                let mut bot = bot();
+                bot.update_mode(&view, false);
+                assert_eq!(bot.mode, EconomyMode::Produce);
+            }
+
+            #[test]
+            fn roster_four_turn_138_switches_deforest() {
+                let view = test_view(4, 138, true);
+                let mut bot = bot();
+                bot.update_mode(&view, false);
+                assert_eq!(bot.mode, EconomyMode::Deforest);
+            }
+
+            #[test]
+            fn missing_source_is_hopeless_but_iron_free_is_omitted() {
