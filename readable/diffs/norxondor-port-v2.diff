+            #[test]
+            fn banana_conversion_is_pick_plant_chop() {
+                let mut view = test_view(2, 200, true);
+                view.inventories[0][BANANA] = 1;
+                let mut bot = bot();
+                bot.mode = EconomyMode::Deforest;
+                bot.prepare_plant_job(&view, false);
+                let mut job = bot.plant_job.expect("banana conversion job");
+                assert_eq!(job.purpose, PlantPurpose::Conversion);
+                let acquire = YamoBot::job_candidates(&view, &view.units[0], job);
+                assert!(acquire.iter().any(|candidate| candidate.command == "PICK 0 BANANA"));
+
+                job.stage = PlantStage::Carry;
+                view.units[0].carry[BANANA] = 1;
+                view.units[0].cell = job.cell;
+                let carry = YamoBot::job_candidates(&view, &view.units[0], job);
+                assert!(carry.iter().any(|candidate| candidate.command == "PLANT 0 BANANA"));
+
+                job.stage = PlantStage::AwaitPlant;
+                bot.plant_job = Some(job);
+                view.plants.push(Plant {
+                    kind: PlantKind::Banana,
+                    cell: job.cell,
+                    size: 1,
+                    health: 2,
+                    fruits: 0,
+                    cooldown: 6,
+                });
+                bot.reconcile_port_state(&view);
+                let cut_job = bot.plant_job.expect("cut stage");
+                assert_eq!(cut_job.stage, PlantStage::Cut);
