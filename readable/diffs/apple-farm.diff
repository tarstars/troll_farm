+            // The owner's one-variable experiment of 2026-08-27 ("let's do it"; design 1c, 2 yes).
+            // If a grass cell touching our shack also touches water, the starting troll plants an
+            // apple there on turns 1-3 (a water-side apple regrows a fruit every 2 turns), runs the
+            // normal opening, and once the second troll exists returns to harvest it to the end
+            // of the game -- HARVEST and DROP alternating without moving, half a point a turn.
+            // No own troll ever fells the farm tree. Everything else is the champion.
+            //
+            // The farm cell: a door of our shack (walkable, touching water, never the shack's
+            // only door), preferring one that already holds an apple, else an empty one.
+            // --------------------------------------------------------------------------
+            fn farm_cell(view: &GameState) -> Option<Cell> {
+                let doors: Vec<Cell> = ortho_neighbors(view.shacks[0])
+                    .into_iter()
+                    .filter(|cell| view.walkable.contains(cell))
+                    .collect();
+                if doors.len() < 2 {
+                    return None;
+                }
+                let wet: Vec<Cell> = doors
+                    .into_iter()
+                    .filter(|cell| view.water.iter().any(|water| is_adjacent(*water, *cell)))
+                    .collect();
+                let holds_apple = |cell: &Cell| {
+                    view.plant_at(*cell).is_some_and(|index| {
+                        view.plants[index].kind == PlantKind::Apple && view.plants[index].health > 0
+                    })
+                };
+                wet.iter()
+                    .find(|cell| holds_apple(cell))
+                    .or_else(|| wet.iter().find(|cell| view.plant_at(**cell).is_none()))
+                    .copied()
+            }
