+            // --------------------------------------------------------------------------
+            const OPENING_ENABLE_THIRD: bool = false;
+            const OPENING_THIRD_LATEST: i32 = 110;
+            const OPENING_THIRD_MIN_NET: f64 = 8.0;
+            const OPENING_THIRD_RECHECK: i32 = 5;
+            const OPENING_RESOURCE_INF: i32 = 20_000;
