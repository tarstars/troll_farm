+            /// D171a oscillation breaker. Detects the same-two-cell reversal pattern with the
+            /// exact B3.2/B3.4 predicate (`positions[k]==positions[k-2] && positions[k]!=positions[k-1]`)
+            /// from each own unit's *pre-conflict-resolution* command in `selected` (which still
+            /// encodes the far MOVE target, before `resolve_move_conflicts*` rewrites it to a
+            /// one-step landing cell). After 3 confirmed reversals with an unchanged target, the
+            /// unit is armed and its retreat cell (`one_ago`, the distinct cell of the confirmed
+            /// A/B pair) is returned for the *next* turn's `forbidden_for_non_priority` set,
+            /// breaking the tie in the existing detour search toward "go around" instead of
+            /// "retreat". Disarms on target change or measured BFS-distance progress since arming.
+            /// Returns the forbidden cells plus the set of unit ids they were armed for, so the
+            /// caller can verify no other unit's command was perturbed (command-purity gate).
+            fn oscillation_forbidden_cells(
+                &mut self,
+                view: &GameState,
+                selected: &[String],
+            ) -> (BTreeSet<Cell>, BTreeSet<i32>) {
+                let own_ids: BTreeSet<i32> = view
+                    .units
+                    .iter()
+                    .filter(|unit| unit.player == 0)
+                    .map(|unit| unit.id)
+                    .collect();
+                self.oscillation_memory.retain(|id, _| own_ids.contains(id));
+                let mut forbidden = BTreeSet::new();
+                let mut armed = BTreeSet::new();
+                for unit in view.units.iter().filter(|unit| unit.player == 0) {
+                    let current = unit.cell;
+                    let target = selected.iter().find_map(|command| {
+                        let (id, target) = MoisanBot::move_command(command)?;
+                        (id == unit.id).then_some(target)
+                    });
+                    let entry = self.oscillation_memory.entry(unit.id).or_default();
+
+                    if entry.forbidden.is_some() {
+                        let target_changed = target != entry.armed_target;
+                        let progressed =
+                            entry.armed_target.zip(entry.armed_distance).is_some_and(
+                                |(goal, prior)| {
+                                    bfs_distances(&view.walkable, &[goal])
+                                        .get(&current)
+                                        .is_some_and(|&distance| distance < prior)
+                                },
+                            );
+                        if target_changed || progressed {
+                            entry.reversals = 0;
+                            entry.forbidden = None;
+                            entry.armed_target = None;
+                            entry.armed_distance = None;
+                        }
+                    }
+
+                    if let Some(cell) = entry.forbidden {
+                        forbidden.insert(cell);
+                        armed.insert(unit.id);
+                    }
+
+                    let is_reversal = target.is_some()
+                        && target == entry.target
+                        && entry.two_ago == Some(current)
+                        && entry.one_ago != Some(current);
+                    if is_reversal {
+                        entry.reversals = entry.reversals.saturating_add(1);
+                    } else if entry.forbidden.is_none() {
+                        entry.reversals = 0;
+                    }
+
+                    if entry.reversals >= 3 && entry.forbidden.is_none() {
+                        entry.forbidden = entry.one_ago;
+                        entry.armed_target = target;
+                        entry.armed_distance = target
+                            .map(|goal| bfs_distances(&view.walkable, &[goal]))
+                            .and_then(|distances| distances.get(&current).copied());
+                    }
+
+                    entry.two_ago = entry.one_ago;
+                    entry.one_ago = Some(current);
+                    entry.target = target;
+                }
+                (forbidden, armed)
+            }
