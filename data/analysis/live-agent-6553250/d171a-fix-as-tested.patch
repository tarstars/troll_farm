+                let b = (2, 0);
+                let target = (1, -1);
+                let mut view = GameState::empty(8, 8);
+                view.units.push(Unit {
+                    id: armed_id,
+                    player: 0,
+                    cell: a,
+                    stats: Stats {
+                        movement_speed: 1,
+                        carry_capacity: 1,
+                        harvest_power: 1,
+                        chop_power: 1,
+                    },
+                    carry: [0; 6],
+                });
+                view.units.push(Unit {
+                    id: quiet_id,
+                    player: 0,
+                    cell: (5, 5),
+                    stats: Stats {
+                        movement_speed: 1,
+                        carry_capacity: 1,
+                        harvest_power: 1,
+                        chop_power: 1,
+                    },
+                    carry: [0; 6],
+                });
+                let mut bot = YamoBot::tuned_carry_regeneration_transit_idle_harvest();
+                // The quiet unit marches in a straight line: never a reversal candidate.
+                let quiet_path = [(5, 5), (5, 4), (5, 3), (5, 2), (5, 1), (5, 0)];
+                let armed_path = [a, b, a, b, a, b];
+                let mut last = (BTreeSet::new(), BTreeSet::new());
+                for step in 0..armed_path.len() {
+                    view.units[0].cell = armed_path[step];
+                    view.units[1].cell = quiet_path[step];
+                    let selected = vec![
+                        format!("MOVE {} {} {}", armed_id, target.0, target.1),
+                        format!("MOVE {} {} {}", quiet_id, 5, -5),
+                    ];
+                    last = bot.oscillation_forbidden_cells(&view, &selected);
+                }
+                assert_eq!(last.1, BTreeSet::from([armed_id]));
+                assert!(!last.0.contains(&(5, 0)));
+                assert_eq!(bot.oscillation_memory[&quiet_id].reversals, 0);
+            }
+        }
