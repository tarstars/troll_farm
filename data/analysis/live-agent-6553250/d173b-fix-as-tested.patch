+
+            // D173b: harvest-before-chop trigger-fidelity repair. These replace D173a's
+            // `harvest_before_chop_candidate` tests (that fn no longer exists -- the fix is
+            // now a post-selection rewrite of the resident's own final assigned commands,
+            // `harvest_before_chop_rewrite`); the mapping is 1:1 except test 1 below, which
+            // is strictly stronger than D173a's old "non_chop_assignment" test since it
+            // exercises a real losing CHOP candidate through the real `MoisanBot::select`
+            // rather than an empty candidate list.
+
+            #[test]
+            fn harvest_before_chop_not_emitted_for_transit_unit_passing_fruited_tree() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let mut by_id = BTreeMap::new();
+                by_id.insert(
+                    7,
+                    vec![
+                        Candidate {
+                            command: "CHOP 7".to_string(),
+                            score: 100.0,
+                            target: Target::Tree(view.units[0].cell),
+                        },
+                        Candidate {
+                            command: "MOVE 7 3 3".to_string(),
+                            score: 200.0,
+                            target: Target::Cell((3, 3)),
+                        },
+                    ],
+                );
+                let mut selected = MoisanBot::select(by_id, &view.inventories[0]);
+                assert_eq!(selected, vec!["MOVE 7 3 3".to_string()]);
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(
+                    selected,
+                    vec!["MOVE 7 3 3".to_string()],
+                    "a transit unit whose real assignment is MOVE must not be rewritten to \
+                     HARVEST merely because a losing CHOP candidate existed for its own cell"
+                );
+            }
+
+            #[test]
+            fn harvest_before_chop_emitted_when_units_actual_assigned_action_is_chop_on_fruited_own_cell(
+            ) {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let mut by_id = BTreeMap::new();
+                by_id.insert(
+                    7,
+                    vec![Candidate {
+                        command: "CHOP 7".to_string(),
+                        score: 100.0,
+                        target: Target::Tree(view.units[0].cell),
+                    }],
+                );
+                let mut selected = MoisanBot::select(by_id, &view.inventories[0]);
+                assert_eq!(selected, vec!["CHOP 7".to_string()]);
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["HARVEST 7".to_string()]);
+            }
+
+            #[test]
+            fn harvest_before_chop_not_emitted_for_trained_hp0_unit() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                view.units[0].stats.harvest_power = 0;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["CHOP 7".to_string()]);
+            }
+
+            #[test]
+            fn harvest_before_chop_not_emitted_for_unfruited_tree() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                view.plants[0].fruits = 0;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["CHOP 7".to_string()]);
+            }
+
+            #[test]
+            fn harvest_before_chop_not_emitted_beyond_shack_distance_two() {
+                let mut view = fixture();
+                view.units[0].cell = (4, 4);
+                view.plants[0].cell = view.units[0].cell;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["CHOP 7".to_string()]);
+            }
+
+            #[test]
+            fn harvest_before_chop_not_emitted_when_unit_is_the_scarce_farmer() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, Some(7), false);
+                assert_eq!(
+                    selected,
+                    vec!["CHOP 7".to_string()],
+                    "scarce_farmer_candidates is one of the two candidate generators D173a's \
+                     protocol never touched; this fix must not widen coverage to it"
+                );
+            }
+
+            #[test]
+            fn harvest_before_chop_not_emitted_during_early_opening_phase() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, true);
+                assert_eq!(
+                    selected,
+                    vec!["CHOP 7".to_string()],
+                    "early_candidates is the other candidate generator D173a's protocol never \
+                     touched; this fix must not widen coverage to it"
+                );
+            }
+
+            #[test]
+            fn harvest_before_chop_resumes_chop_next_turn_once_fruit_is_gone() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let mut selected = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["HARVEST 7".to_string()]);
+
+                view.plants[0].fruits = 0;
+                let mut resumed = vec!["CHOP 7".to_string()];
+                YamoBot::harvest_before_chop_rewrite(&view, &mut resumed, None, false);
+                assert_eq!(
+                    resumed,
+                    vec!["CHOP 7".to_string()],
+                    "once the fruit is gone the rewrite must no-op, letting the resident's own \
+                     unmodified chop resume next turn -- this fix keeps no cross-turn memory"
+                );
+            }
+
+            #[test]
+            fn harvest_before_chop_converts_endgames_hardcoded_chop_override_when_it_wins_selection(
+            ) {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let candidates =
+                    YamoBot::endgame_candidates(&view, &view.units[0], None, false, None, 0);
+                assert!(candidates
+                    .iter()
+                    .any(|candidate| candidate.command == "CHOP 7" && candidate.score == 10_000.0));
+                let mut by_id = BTreeMap::new();
+                by_id.insert(7, candidates);
+                let mut selected = MoisanBot::select(by_id, &view.inventories[0]);
+                assert_eq!(selected, vec!["CHOP 7".to_string()]);
+                YamoBot::harvest_before_chop_rewrite(&view, &mut selected, None, false);
+                assert_eq!(selected, vec!["HARVEST 7".to_string()]);
+            }
         }
     }
