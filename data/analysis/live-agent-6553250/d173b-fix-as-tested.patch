+            /// D173b: harvest-before-chop, trigger-fidelity repair of D173a. D173a's own
+            /// trigger fired whenever a CHOP candidate merely existed for the unit's own
+            /// cell -- satisfied even by a transit unit merely passing through a fruited
+            /// cell on its way to a better target elsewhere (41/60 sampled activations;
+            /// B3.5's own `transit_passthrough` sub-class), not only by the genuine
+            /// chop-shadow population the fix was scoped to. This repair reads the unit's
+            /// *actual assigned winning action* -- the literal command `MoisanBot::select`
+            /// already chose for that unit this turn, absent this fix -- instead of
+            /// candidate existence: only when the resident's own assignment already chose
+            /// `CHOP {id}` for a harvest-capable unit whose own cell carries ripe fruit
+            /// within shack distance 2 does this rewrite that single command to
+            /// `HARVEST {id}` for exactly this turn (chop resumes next turn once the fruit
+            /// is gone -- this is a stateless post-selection rewrite recomputed fresh from
+            /// `view`/`commands` on every call, mirroring the
+            /// `apply_opponent_crop_harvest_contact` rewrite immediately above, which is
+            /// likewise a same-cell CHOP-to-HARVEST substitution keyed off the literal
+            /// selected command string rather than a re-derived candidate). Confined to the
+            /// same two candidate generators D173a's protocol scoped this fix to
+            /// (`main_candidates`/`endgame_candidates`): units routed to
+            /// `scarce_farmer_candidates` or the opening `early_candidates` path (the two
+            /// generators D173a never touched) are excluded by construction via the
+            /// `scarce_farmer_id`/`early` guards the caller already computes.
+            fn harvest_before_chop_rewrite(
+                view: &GameState,
+                commands: &mut [String],
+                scarce_farmer_id: Option<i32>,
+                early: bool,
+            ) {
+                if early {
+                    return;
+                }
+                for command in commands {
+                    let unit_id = {
+                        let fields: Vec<_> = command.split_whitespace().collect();
+                        if fields.first() != Some(&"CHOP") {
+                            continue;
+                        }
+                        let Some(unit_id) = fields.get(1).and_then(|value| value.parse().ok())
+                        else {
+                            continue;
+                        };
+                        unit_id
+                    };
+                    if scarce_farmer_id == Some(unit_id) {
+                        continue;
+                    }
+                    let Some(unit) = view.unit(unit_id).filter(|unit| unit.player == 0) else {
+                        continue;
+                    };
+                    if unit.stats.harvest_power <= 0 || unit.free_capacity() <= 0 {
+                        continue;
+                    }
+                    let Some(plant) = view.plant_at(unit.cell).map(|index| &view.plants[index])
+                    else {
+                        continue;
+                    };
+                    if plant.fruits <= 0 {
+                        continue;
+                    }
+                    let shack_starts: Vec<Cell> = ortho_neighbors(view.shacks[0])
+                        .into_iter()
+                        .filter(|cell| view.walkable.contains(cell))
+                        .collect();
+                    let to_shack = bfs_distances(&view.walkable, &shack_starts);
+                    if to_shack.get(&unit.cell).copied().unwrap_or(10_000) > 2 {
+                        continue;
+                    }
+                    *command = format!("HARVEST {}", unit_id);
+                }
+            }
             fn tree_targets_by_command(
                 candidates: &BTreeMap<i32, Vec<Candidate>>,
             ) -> BTreeMap<String, Cell> {
@@ -3663,6 +3733,7 @@ pub mod bot {
                 self.remember_selected_regeneration(view, &selected);
                 self.apply_opponent_crop_harvest_contact(view, &mut selected);
