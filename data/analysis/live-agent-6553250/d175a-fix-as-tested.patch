+                    return Some(if distance == 0 {
+                        Candidate {
+                            command: format!("PLANT {} {}", unit.id, kind.as_str()),
+                            score: 9_800.0,
+                            target: Target::Cell(cell),
+                        }
+                    } else {
+                        Candidate {
+                            command: format!("MOVE {} {} {}", unit.id, cell.0, cell.1),
