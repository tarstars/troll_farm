+            // D175a -- bounded early planting. Unit tests for `bounded_early_plant_candidate`
+            // covering exactly the scenarios the protocol's "Unit tests" paragraph lists:
+            // emitted under the full conjunction; NOT emitted at 6+ live crops, after turn
+            // 120, with no seed, with no cell within distance 2, when the CHOP is
+            // bill-critical, or in endgame; CHOP resumes next turn.
+
+            #[test]
+            fn bounded_early_plant_emitted_under_full_conjunction() {
+                let mut view = fixture();
+                view.turn = 50;
+                view.units[0].carry[PLUM] = 1;
+                let bot = YamoBot::tuned_carry_regeneration_transit_idle_harvest();
+                let candidate = bot
+                    .bounded_early_plant_candidate(&view, &view.units[0])
+                    .expect("full conjunction should emit a candidate");
+                assert_eq!(candidate.command, "PLANT 7 PLUM");
+                assert_eq!(candidate.score, 9_800.0);
+                assert_eq!(candidate.target, Target::Cell((1, 1)));
+            }
+
