+            /// D173a: harvest-before-chop. A stateless, same-turn candidate for a
+            /// harvest-capable unit whose current chop target (from `chops`, already
+            /// computed by the caller) is the plant on the unit's own cell: if that tree
+            /// carries ripe fruit and the cell is within shack distance 2 (bounding the
+            /// forced carry-capacity-1 bank round trip), harvest for exactly this turn
+            /// instead of destroying the fruit with the chop -- the chop resumes next turn
+            /// since this is recomputed fresh from `view`/`unit`/`chops` on every call, with
+            /// no cross-turn memory. Reuses the existing "standing on a ripe tree" pattern
+            /// (`fruit_candidates`, `scarce_farmer_candidates`'s `HarvestSeed` branch) and
+            /// the existing shack-distance-<=2 pattern (`scarce_plant_cell`).
+            fn harvest_before_chop_candidate(
+                view: &GameState,
+                unit: &Unit,
+                chops: &[Candidate],
+            ) -> Option<Candidate> {
+                if unit.stats.harvest_power <= 0 || unit.free_capacity() <= 0 {
+                    return None;
+                }
+                let chop_command = format!("CHOP {}", unit.id);
+                if !chops.iter().any(|candidate| candidate.command == chop_command) {
+                    return None;
+                }
+                let plant = view.plant_at(unit.cell).map(|index| &view.plants[index])?;
+                if plant.fruits <= 0 {
+                    return None;
+                }
+                let shack_starts: Vec<Cell> = ortho_neighbors(view.shacks[0])
+                    .into_iter()
+                    .filter(|cell| view.walkable.contains(cell))
+                    .collect();
+                let to_shack = bfs_distances(&view.walkable, &shack_starts);
+                if to_shack.get(&unit.cell).copied().unwrap_or(10_000) > 2 {
+                    return None;
+                }
+                Some(Candidate {
+                    command: format!("HARVEST {}", unit.id),
+                    score: 5_000.0,
+                    target: Target::Tree(unit.cell),
+                })
+            }
