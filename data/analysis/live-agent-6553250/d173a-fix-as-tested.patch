+            #[test]
+            fn harvest_before_chop_fires_under_triple_condition() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let chops = vec![Candidate {
+                    command: "CHOP 7".to_string(),
+                    score: 100.0,
+                    target: Target::Tree(view.units[0].cell),
+                }];
+                let harvest =
+                    YamoBot::harvest_before_chop_candidate(&view, &view.units[0], &chops);
+                assert_eq!(
+                    harvest.map(|candidate| candidate.command),
+                    Some("HARVEST 7".to_string())
+                );
+            }
