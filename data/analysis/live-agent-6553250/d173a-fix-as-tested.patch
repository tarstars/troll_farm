+            #[test]
+            fn harvest_before_chop_wins_in_main_candidates_and_chop_resumes_after() {
+                let mut view = fixture();
+                view.plants[0].cell = view.units[0].cell;
+                let armed =
+                    YamoBot::main_candidates(&view, &view.units[0], None, false, false, None, 0);
+                assert!(armed.iter().any(|candidate| candidate.command == "HARVEST 7"));
+                assert!(!armed.iter().any(|candidate| candidate.command == "CHOP 7"));
+                let best = armed
