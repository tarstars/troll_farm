+            /// D174a -- opportunistic mining: lift the workforce-2 mining gate (B3.9).
+            ///
+            /// `iron_candidates` is the sole MINE-candidate constructor and is reachable
+            /// only from `early_candidates`, itself gated to own-unit-count < 2. From
+            /// workforce 2 onward the resident never mines again even though every
+            /// trained unit already has chop_power >= 1 (`opening_options` never emits
+            /// chop_power 0 -- no second capability wall, unlike harvest).
+            ///
+            /// This is a post-selection rewrite of the unit's own already-resolved
+            /// assigned command, not a scored candidate injected before `select()` --
+            /// deliberately, because condition (d) below needs to know the unit's *true*
+            /// assignment outcome for the turn (D173a's lesson: a pre-selection
+            /// candidate-existence trigger fires on transit units whose real winner is
+            /// something else; D173b's own post-selection rewrite fixed that at 100%
+            /// fidelity). Positional zip against a freshly sorted own-unit list (not
+            /// string-parsing the unit id out of `commands`) so a bare "WAIT" -- which
+            /// carries no id in this engine -- is still correctly attributable and
+            /// eligible, matching `select()`'s own by-construction index correspondence
+            /// (`commands[i]` = i-th smallest-id own unit's command, unchanged by
+            /// `resolve_move_conflicts`). No cross-turn state: recomputed fresh from
+            /// `view`/`commands`/`desired` every call (the D171a stale-arm lesson).
+            ///
+            /// Runs after `apply_opponent_crop_harvest_contact` (this file's closest
+            /// architectural sibling: also a same-cell post-selection command-string
+            /// rewrite) so that mechanism's own crop-denial rewrites are evaluated
+            /// against the unit's fully-resolved assignment, matching where D173b placed
+            /// its own analogous rewrite.
+            ///
+            /// Conditions, ALL required (frozen, exact -- Delta 1):
+            /// (a) the unit stands on, or is orthogonally adjacent to, an iron source --
+            ///     `is_adjacent`, the identical check `iron_candidates` itself uses;
+            ///     "standing on" is physically unreachable (iron is not walkable) so this
+            ///     is exactly `iron_candidates`'s own adjacency test, reused verbatim;
+            /// (b) the unit has free carry capacity (`free_capacity() > 0`);
+            /// (c) an unmet TRAIN bill for the cheapest currently-planned worker spec
+            ///     (the bot's own already-computed `desired`) still needs IRON:
+            ///     deposited + carried across all own units < bill IRON, bill IRON from
+            ///     the same `training_cost(n, desired.tuple())` formula `early_candidates`
+            ///     already uses;
+            /// (d) the unit's assigned action for this turn is not itself bill-critical:
+            ///     do not displace a DROP while the unit carries IRON (that DROP is what
+            ///     banks it toward the very same bill), and -- defensively, since PICK's
+            ///     argument is a `PlantKind` and can in practice never be IRON -- do not
+            ///     displace a `PICK id IRON` either.
+            ///
+            /// Opportunistic only: no MOVE-toward-iron candidates are generated (unlike
+            /// the second half of `iron_candidates`), no routing, no reservation, no new
+            /// state machine -- the unit's previous task simply resumes next turn because
+            /// nothing about it was remembered.
+            fn opportunistic_mine_rewrite(view: &GameState, commands: &mut [String], desired: Stats) {
+                let mut my_units: Vec<&Unit> =
+                    view.units.iter().filter(|unit| unit.player == 0).collect();
+                my_units.sort_by_key(|unit| unit.id);
+                if my_units.len() < 2 || my_units.len() != commands.len() {
+                    return;
+                }
+                let n = my_units.len() as i32;
+                let bill_iron = training_cost(n, desired.tuple())[IRON];
+                if bill_iron <= 0 {
+                    return;
+                }
+                let carried_iron: i32 = my_units.iter().map(|unit| unit.carry[IRON]).sum();
+                let deposited_iron = view.inventories[0][IRON];
+                if deposited_iron + carried_iron >= bill_iron {
+                    return;
+                }
+                for (unit, command) in my_units.iter().zip(commands.iter_mut()) {
+                    if unit.free_capacity() <= 0 {
+                        continue;
+                    }
+                    if !view.iron.iter().any(|iron| is_adjacent(*iron, unit.cell)) {
+                        continue;
+                    }
+                    let fields: Vec<&str> = command.split_whitespace().collect();
+                    let verb = fields.first().copied().unwrap_or("");
+                    if verb.eq_ignore_ascii_case("DROP") && unit.carry[IRON] > 0 {
+                        continue;
+                    }
+                    if verb.eq_ignore_ascii_case("PICK") && fields.get(2) == Some(&"IRON") {
+                        continue;
+                    }
+                    *command = format!("MINE {}", unit.id);
+                }
+            }
